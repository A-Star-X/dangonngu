# Môi trường (APP-17): production, staging hoặc demo. demo là bản dùng thử không cần đăng nhập (AU-08). Để trống là production.
NEXT_PUBLIC_APP_ENV=
# Địa chỉ công khai của website, dùng cho metadata, canonical, sitemap (APP-16). Ví dụ https://vitasr.example.com
NEXT_PUBLIC_SITE_URL=
# Supabase (QD-06). Để trống thì app chạy chế độ thử: tài khoản chỉ lưu trên trình duyệt này (AU-06).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL của bộ dữ liệu câu (DATA-05). Mặc định /data (thư mục public/data).
NEXT_PUBLIC_DATA_BASE_URL=
